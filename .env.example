# Biến môi trường mẫu cho S4 (Không điền giá trị thật / bí mật vào file này)
APP_ENV=development

# Cấu hình LLM (Sẽ kích hoạt khi nhóm thống nhất nhà cung cấp chính thức)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_NAME=

# Cấu hình Token & Giới hạn an toàn (Tham chiếu app/config.py)
CONFIG_VERSION=1.0.0
PROMPT_VERSION=v1.0

